# Copy this file to ".env" and adjust. All values are optional (defaults shown).
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=airline_db
# Leave DB_PORT unset to auto-try 3306 then 3307
# DB_PORT=3306

PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
# The account registered with this email becomes admin
ADMIN_EMAIL=admin@gmail.com

# Set this to the official UAT test secret from the eSewa ePay V2 documentation.
ESEWA_ENVIRONMENT=uat
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=<official_uat_test_secret>
# Browser-return URL and backend callback URL. Use a public HTTPS tunnel URL for remote UAT testing.
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:5000
