# Copy this file to ".env" and adjust. All values are optional (defaults shown).
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=airline_db
# Leave DB_PORT unset to auto-try 3306 then 3307
# DB_PORT=3306

PORT=5000
BASE_URL=http://localhost:5000
JWT_SECRET=change_this_to_a_long_random_string
# The account registered with this email becomes admin
ADMIN_EMAIL=sagarmishra761271@gmail.com

# Aviationstack flight-status API key. Leave blank to disable live flight search.
AVIATIONSTACK_API_KEY=

# PAYMENT_MODE=mock runs the local fake gateway; sandbox redirects to real eSewa UAT.
PAYMENT_MODE=mock
ESEWA_ENVIRONMENT=uat
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace_with_server_side_uat_secret
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Use a reachable HTTPS tunnel URL for real remote UAT callbacks.
APP_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
